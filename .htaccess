# ==============================================================================
# Kindle Womb IVF & Fertility Centre - Universal Apache Configuration
# Canonical Production Domain: https://kindlewombivfgroup.com/
# Clean Extensionless URLs (No .html in URL bar)
# ==============================================================================

Options -MultiViews
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Permanent 301 Redirect for Old / Staging Domains (kindlewombivfgroup5.com)
    RewriteCond %{HTTP_HOST} ^(?:www\.|blog\.)?kindlewombivfgroup5\.com$ [NC]
    RewriteRule ^(.*)$ https://kindlewombivfgroup.com/$1 [R=301,L]

    # 2. Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # 3. Canonical Domain (Enforce non-www on production domain)
    RewriteCond %{HTTP_HOST} ^www\.kindlewombivfgroup\.com$ [NC]
    RewriteRule ^(.*)$ https://kindlewombivfgroup.com/$1 [R=301,L]

    # 4. Strip .html extension with 301 Permanent Redirect
    # If a user or crawler lands on /donor-ivf-services.html, redirect to /donor-ivf-services
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 5. Clean URLs: Internally map clean URL requests to the underlying .html files
    # Check if request is a directory first
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Strategy A: Using REQUEST_FILENAME
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [NC,L]

    # Strategy B: Fallbacks for subdirectories and root
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^location-pages/([^/]+)/?$ location-pages/$1.html [NC,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^posts/([^/]+)/?$ posts/$1.html [NC,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([^/]+)/?$ $1.html [NC,L]
</IfModule>

# 6. Custom 404 Error Page
ErrorDocument 404 /404.html

# 7. Gzip Compression for Core Web Vitals & Fast Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 8. Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Images & Media
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    
    # Stylesheets and Javascripts
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # HTML Files
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# 9. Security Headers
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
